        "#@title Initialise SI buffers\n",
        "\n",
        "def init_si(model):\n",
        "    for name, param in model.named_parameters():\n",
        "        if param.requires_grad:\n",
        "            param.si_omega = torch.zeros_like(param.data)\n",
        "            param.si_W = torch.zeros_like(param.data)\n",
        "            param.si_prev = param.data.clone()"
      ],
