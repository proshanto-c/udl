      "cell_type": "code",
      "source": [
        "#@title Update Omega after each task\n",
        "\n",
        "def update_omega(model, epsilon=1e-8):\n",
        "    for name, param in model.named_parameters():\n",
        "        if param.requires_grad:\n",
        "            delta = param.data - param.si_prev\n",
        "            model_param_omega = param.si_W / (delta**2 + epsilon)\n",
        "            model_param_omega = torch.clamp(model_param_omega, min=0)  # Clip negative values to\n",
        "            # assert (model_param_omega >= 0).all(), f\"model_param_omega contains negative values: {model_param_omega.min()}, si_omega: {param.si_omega}\"\n",
        "            param.si_omega += model_param_omega\n",
        "            param.si_W.zero_()\n",
        "            param.si_prev = param.data.clone()"
      ],
      "metadata": {
        "id": "OUwKG8v-gQmn"
      },
      "execution_count": 16,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#@title Regularisation Loss\n",
        "\n",
        "def compute_si_reg_loss(model, c):\n",
        "    reg_loss = 0.0\n",
        "    for name, param in model.named_parameters():\n",
        "        if param.requires_grad:\n",
        "            # add_term = torch.sum(param.si_omega * (param.data - param.si_prev) ** 2)\n",
        "            reg_loss += torch.sum(param.si_omega * (param.data - param.si_prev) ** 2)\n",
        "            # reg_loss = torch.clamp(reg_loss, min=0)\n",
        "    return c * reg_loss"
