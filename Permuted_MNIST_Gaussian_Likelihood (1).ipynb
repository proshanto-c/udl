        "#@title Train\n",
        "\n",
        "def train_ewc(model, optimizer, train_loader, ewc_list=None, lambda_ewc=1000.0, num_epochs=20, task_id=None, out_dim=10):\n",
        "    model.train()\n",
        "    for epoch in tqdm(range(num_epochs)):\n",
        "        for x, y in train_loader:\n",
        "            x, y = x.to(device), y.to(device)\n",
        "            y = F.one_hot(y, num_classes=out_dim).float()\n",
        "            optimizer.zero_grad()\n",
        "\n",
        "            logits = model(x, task_id)\n",
        "            loss = F.mse_loss(logits, y)\n",
        "\n",
        "            if ewc_list:\n",
        "                for ewc in ewc_list:\n",
        "                    loss += lambda_ewc * ewc.penalty(model)\n",
        "\n",
        "            loss.backward()\n",
        "            optimizer.step()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 22,
      "metadata": {
        "id": "T-QUbApxbx4b"
      },
      "outputs": [],
      "source": [
        "#@title Evaluate\n",
        "\n",
        "def evaluate_ewc(model, data_loader, task_id=None, out_dim=10):\n",
        "    model.eval()\n",
        "    total_loss = 0.0\n",
        "    total_samples = 0\n",
        "    with torch.no_grad():\n",
        "        for x, y in data_loader:\n",
        "            x, y = x.to(device), y.to(device)\n",
        "            y = F.one_hot(y, num_classes=out_dim).float()\n",
        "            logits = model(x, task_id)\n",
        "            loss = F.mse_loss(logits, y, reduction='sum')  # Sum MSE\n",
        "            total_loss += loss.item()\n",
        "            total_samples += y.size(0)\n",
        "\n",
        "    mse = total_loss / total_samples\n",
        "    rmse = mse ** 0.5\n",
        "    return rmse"
      ]
    },
