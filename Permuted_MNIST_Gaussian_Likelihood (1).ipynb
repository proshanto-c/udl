      "source": [
        "#@title Combined\n",
        "\n",
        "def train_and_evaluate_ewc(model, train_sets, test_sets, num_epochs=20, batch_size=256, lr=1e-3, lambda_ewc=1000.0, n_samples=600, out_dim=10):\n",
        "\n",
        "    model.to(device)\n",
        "    optimizer = Adam(model.parameters(), lr=lr)\n",
        "\n",
        "    ewc_list = []\n",
        "\n",
        "    # Store RMSE instead of accuracy\n",
        "    rmse_scores = np.empty(shape=(n_tasks, n_tasks))\n",
        "    rmse_scores.fill(np.nan)\n",
        "\n",
        "    for task_id, train_set in enumerate(train_sets):\n",
        "        print(f\"\\n--- Task {task_id} ---\")\n",
        "\n",
        "        train_loader = DataLoader(train_set, batch_size=batch_size, shuffle=True)\n",
        "        train_ewc(model, optimizer, train_loader, ewc_list, lambda_ewc, num_epochs, task_id, out_dim)\n",
        "\n",
        "        # Save EWC info\n",
        "        ewc = EWC(model, train_loader, task_id, n_samples)\n",
        "        ewc_list.append(ewc)\n",
        "\n",
        "        # Evaluate on all tasks seen so far\n",
        "        for test_id in range(task_id + 1):\n",
        "            test_loader = DataLoader(test_sets[test_id], batch_size=batch_size, shuffle=False)\n",
        "            rmse = evaluate_ewc(model, test_loader, test_id, out_dim)\n",
        "            rmse_scores[task_id, test_id] = rmse\n",
        "            print(f\"RMSE on Task {test_id}: {rmse:.4f}\")\n",
        "\n",
        "        print(f\"RMSE Matrix:\\n{np.array(rmse_scores)}\")\n",
        "    return rmse_scores"
      ]
    },
