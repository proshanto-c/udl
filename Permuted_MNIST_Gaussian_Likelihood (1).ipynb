        "#@title Train SI\n",
        "\n",
        "def train_si(model, optimizer, train_loader, task_id, lambda_si=0.5, num_epochs=10, out_dim=10):\n",
        "    model.train()\n",
        "    for epoch in range(num_epochs):\n",
        "        total_loss = 0.0\n",
        "        for x, y in train_loader:\n",
        "            x, y = x.to(device), y.to(device)\n",
        "            y = F.one_hot(y, num_classes=out_dim).float()\n",
        "\n",
        "            optimizer.zero_grad()\n",
        "            output = model(x, task_id)\n",
        "\n",
        "            mse_loss = F.mse_loss(output, y)\n",
        "            if task_id > 0:\n",
        "                si_reg = compute_si_reg_loss(model, lambda_si)\n",
        "                loss = mse_loss + si_reg\n",
        "            else:\n",
        "                loss = mse_loss\n",
        "\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "            accumulate_contributions(model)\n",
        "\n",
        "            total_loss += loss.item()\n",
        "\n",
        "        # Avoid printing si_reg when task_id == 0\n",
        "        reg_loss_value = si_reg.item() if task_id > 0 else 0.0\n",
        "        print(f\"[Task {task_id+1}] Epoch {epoch+1}/{num_epochs} - Loss: {total_loss:.4f}; SI Reg Loss: {reg_loss_value:.4f}\")\n",
        "\n",
        "    update_omega(model)"
      ],
      "metadata": {
        "id": "NVEC2XuRhQaB"
      },
      "execution_count": 27,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#@title Evaluate SI\n",
        "\n",
        "def evaluate_si(model, test_loader, task_id, out_dim=10):\n",
        "    model.eval()\n",
        "    total_loss = 0.0\n",
        "    total_samples = 0\n",
        "    with torch.no_grad():\n",
        "        for x, y in test_loader:\n",
        "            x, y = x.to(device), y.to(device)\n",
        "            y = F.one_hot(y, num_classes=out_dim).float()\n",
        "            output = model(x, task_id)\n",
        "            loss = F.mse_loss(output, y, reduction='sum')  # Sum MSEs\n",
        "            total_loss += loss.item()\n",
        "            total_samples += y.size(0)\n",
        "\n",
        "    mse = total_loss / total_samples\n",
        "    rmse = mse ** 0.5\n",
        "    print(f\"[Task {task_id}] Test RMSE: {rmse:.4f}\")\n",
        "    return rmse"
      ],
