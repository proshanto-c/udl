      "source": [
        "#@title Training Loop\n",
        "\n",
        "def vcl_train(model, train_loader, optim, crit, n_epochs, task_n, MCs, out_dim=10, desc=''):\n",
        "    # Set the model to train mode\n",
        "    model.train()\n",
        "\n",
        "    # Begin training loop\n",
        "    for epoch in tqdm(range(n_epochs), desc=desc):\n",
        "\n",
        "        # Per batch\n",
        "        for x, y in train_loader:\n",
        "            x, y = x.to(device), y.to(device)\n",
        "            optim.zero_grad()\n",
        "            y = F.one_hot(y, num_classes=out_dim).float()\n",
        "\n",
        "            # Make a matrix of T sample answers to perform Monte Carlo approximation\n",
        "            outputs = torch.zeros(x.size(0), out_dim, MCs, device=device)\n",
        "            for s in range(MCs):\n",
        "                outputs[:, :, s] = model(x, task_n)\n",
        "            logits = outputs.mean(dim=-1)\n",
        "\n",
        "            # Loss and backward pass\n",
        "            loss = crit(model, logits, y, task_n=task_n)\n",
        "            loss.backward()\n",
        "            optim.step()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 19,
      "metadata": {
        "id": "jqi551pz_uu8"
      },
      "outputs": [],
      "source": [
        "#@title Evaluation Loop\n",
        "\n",
        "def vcl_eval(model, dataloader, out_dim, task_id, MCs=10):\n",
        "    # Set the model into evaluation mode\n",
        "    model.eval()\n",
        "\n",
        "    # List of RMSE values\n",
        "    rmses = []\n",
        "    for inputs, targets in dataloader:\n",
        "        inputs, targets = inputs.to(device), targets.to(device)\n",
        "        targets = F.one_hot(targets, num_classes=out_dim).float()  # Keep one-hot for consistency with training\n",
        "\n",
        "        # Make a matrix of MCs sample answers to perform Monte Carlo approximation\n",
        "        outputs = torch.zeros(inputs.shape[0], out_dim, MCs, device=device)\n",
        "        for s in range(MCs):\n",
        "            with torch.no_grad():\n",
        "                net_out = model(inputs, task_id)\n",
        "            outputs[:, :, s] = net_out  # Store raw outputs for RMSE calculation\n",
        "\n",
        "        # Average outputs to find answer\n",
        "        output = outputs.mean(dim=-1)\n",
        "\n",
        "        # Calculate RMSE for the batch\n",
        "        rmse = torch.sqrt(F.mse_loss(output, targets)).item()  # Calculate RMSE and convert to Python number\n",
        "        rmses.append(rmse)\n",
        "\n",
        "    return np.mean(rmses)  # Return the average RMSE over all batches"
      ]
    },
